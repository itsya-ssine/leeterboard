{
  "name": "leeterboard",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build --outDir dist/client && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --define:__PRODUCTION_BUNDLE__=true --outfile=server-dist/server.cjs",
    "vercel-build": "vite build",
    "start": "node server-dist/server.cjs",
    "clean": "rm -rf dist server-dist server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --quiet && tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:check-schema": "tsx --test tests/schema-sync.test.ts",
    "admin": "tsx scripts/admin-account.ts",
    "security:check": "tsx scripts/check-security-config.ts",
    "legal:check": "tsx scripts/check-legal-config.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "db:verify-backup": "tsx scripts/verify-backup.ts"
  },
  "dependencies": {
    "@google/genai": "^3.1.0",
    "@libsql/client": "^0.18.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^6.1.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "recharts": "^3.9.2",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.5"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  }
}
