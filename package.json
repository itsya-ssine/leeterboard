{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build --outDir dist/client && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --define:__PRODUCTION_BUNDLE__=true --outfile=server-dist/server.cjs",
    "vercel-build": "vite build",
    "start": "node server-dist/server.cjs",
    "clean": "rm -rf dist server-dist server.js",
    "lint": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "admin": "tsx scripts/admin-account.ts",
    "security:check": "tsx scripts/check-security-config.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "db:verify-backup": "tsx scripts/verify-backup.ts"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@libsql/client": "^0.18.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^6.1.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "recharts": "^3.9.2",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
