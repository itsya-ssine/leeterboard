# Copy to .env for local development. NEVER commit real values.
# In production, set these in the Vercel project settings (use separate
# values for Production / Preview / Development).

# Required. Random, at least 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Leave both empty locally to use the file:local.db SQLite fallback.
# Required in production. Use a least-privilege token, server-side only
# (never prefix these with VITE_).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Comma-separated INTERNAL member ids ("user-...") with admin rights. No
# default: if both admin variables are empty, nobody is an admin. Get an id
# with:  npm run admin -- show-id <username>
# Admins are matched by id, never by name: a name is freed when an account is
# deleted, and the next person to sign up with it must not inherit admin.
ADMIN_USER_IDS=
# DEPRECATED: LeetCode usernames with admin rights. Only used while
# ADMIN_USER_IDS is empty (ignored otherwise). A username can be recycled by
# someone else; an id can't.
ADMIN_LEETCODE_USERNAMES=

# Optional. Comma-separated extra origins allowed to make state-changing API
# requests (only needed if the frontend is served from a different domain).
# The app's own origin is always allowed.
ALLOWED_ORIGINS=

# Optional. Number of reverse proxies in front of the app (used to read the real
# client IP for rate limiting). Defaults to 1 in production and 0 in development.
# Only raise it if you add another proxy or CDN in front of the app.
TRUST_PROXY_HOPS=

# E-mail, used for sign-up verification codes and password reset (see mailer.ts).
# Without a working provider sign-up answers 503 ("temporarily unavailable"):
# the site will not accept accounts it cannot verify. Server-side only, never
# prefix these with VITE_.
#   EMAIL_PROVIDER   resend  (production)  |  outbox  (local development only)
#   EMAIL_API_KEY    the provider's API key (resend)
#   EMAIL_FROM       a sender on a domain you control and have verified with the
#                    provider (SPF and DKIM), e.g. Leeterboard <no-reply@yourdomain.com>
# The outbox provider writes each mail, with its code, to a folder instead of
# sending it. It is refused in production: the server will not start with it.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_OUTBOX_DIR=

# Optional. Only e-mail addresses at these domains may sign up, e.g. your
# school's. Comma-separated, exact match (school.edu does not allow
# mail.school.edu), any letter case. Empty = any domain.
ALLOWED_EMAIL_DOMAINS=
